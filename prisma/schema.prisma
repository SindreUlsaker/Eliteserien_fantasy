// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  /// ID fra fantasy-spillet (teams.id)
  id Int @id

  name      String
  shortName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players   Player[]
}

model Player {
  /// ID fra fantasy-spillet (elements.id)
  id Int @id

  firstName  String
  secondName String
  webName    String

  teamId     Int
  team       Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  positionId Int
  status     String
  removed    Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  effectiveOwnership EffectiveOwnership[]
  entryPicks EntryPick[]
  gameweekStats PlayerGameweekStats[]

  @@index([teamId])
  @@index([positionId])
}

model Gameweek {
  /// ID fra fantasy-spillet (events.id)
  id Int @id

  name String

  deadlineTime DateTime
  releaseTime  DateTime?

  finished    Boolean @default(false)
  dataChecked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  effectiveOwnership EffectiveOwnership[]
  entries EntryGameweek[]
  playerStats PlayerGameweekStats[]

  @@index([deadlineTime])
  @@index([finished])
}

model Bracket {
  id        Int      @id @default(autoincrement())

  /// F.eks. "Top 1k", "Top 10k"
  name      String

  /// Inkluderende rank-grenser (du bestemmer semantikken, men vær konsekvent)
  rankFrom  Int
  rankTo    Int

  /// Praktisk hvis du vil slå av/på brackets uten å slette
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  effectiveOwnership EffectiveOwnership[]

  @@unique([rankFrom, rankTo])
  @@index([active])
}

model EffectiveOwnership {
  id           Int      @id @default(autoincrement())

  gameweekId   Int
  bracketId    Int
  playerId     Int

  /// Anbefaling: 0.0–1.0 (fraction). Du kan alltid formatere til percent i UI.
  eo           Float

  /// Hvor mange entries i denne bracketen som er med i samplet
  sampleSize   Int

  /// Valgfritt, men nyttig for debug / forklaring
  ownedCount   Int?
  captainCount Int?

  computedAt   DateTime @default(now())

  gameweek     Gameweek @relation(fields: [gameweekId], references: [id])
  bracket      Bracket  @relation(fields: [bracketId], references: [id])
  player       Player   @relation(fields: [playerId], references: [id])

  @@unique([gameweekId, bracketId, playerId])
  @@index([gameweekId, bracketId])
  @@index([playerId])
}

model Entry {
  /// ID fra fantasy-spillet (entry id)
  id Int @id

  /// Lagnavn
  entryName String

  /// Fullt navn / manager name
  playerName String

  /// Siste kjente rank i overall (fra standings)
  lastOverallRank  Int?
  lastOverallTotal Int?

  /// Hvilken league vi sist syncet fra (typisk 329)
  sourceLeagueId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameweeks EntryGameweek[]
  insights  EntryInsights?

  @@index([entryName])
  @@index([playerName])
  @@index([lastOverallRank])
}

model EntryGameweek {
  id         Int      @id @default(autoincrement())

  entryId    Int
  gameweekId Int

  fetchedAt  DateTime @default(now())

  /// Liten subset fra entry_history (fra picks-endpointet)
  points             Int?
  totalPoints        Int?
  overallRank        Int?
  rank               Int?
  bank               Int?
  value              Int?
  eventTransfers     Int?
  eventTransfersCost Int?

  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gameweek  Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  picks     EntryPick[]

  @@unique([entryId, gameweekId])
  @@index([gameweekId])
  @@index([entryId])
}

model EntryPick {
  id              Int  @id @default(autoincrement())

  entryGameweekId Int

  /// Player id fra fantasy (elements.id)
  playerId        Int
  position        Int
  multiplier      Int
  isCaptain       Boolean
  isViceCaptain   Boolean
  elementType     Int

  entryGameweek   EntryGameweek @relation(fields: [entryGameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([entryGameweekId, position])
  @@index([playerId])
}

model EntryInsights {
  id        Int      @id @default(autoincrement())

  entryId   Int      @unique

  /// “Hvor langt” computed gjelder (typisk siste finished GW vi har komplett for)
  computedThroughGameweekId Int

  /// Bump når du endrer beregningslogikk
  version   Int      @default(1)

  /// Ferdig “produkt” til UI (captain/teamcomp/playstyle)
  data      Json

  computedAt DateTime @default(now())

  entry     Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([computedThroughGameweekId])
}

model PlayerGameweekStats {
  id         Int      @id @default(autoincrement())

  playerId   Int
  gameweekId Int

  /// Aggregert per round (dobbeltrunde => sum)
  fixtureCount Int @default(0)

  totalPoints Int @default(0)
  minutes     Int @default(0)

  goalsScored Int @default(0)
  assists     Int @default(0)
  cleanSheets Int @default(0)
  goalsConceded Int @default(0)

  yellowCards Int @default(0)
  redCards    Int @default(0)

  saves       Int @default(0)
  bonus       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([playerId, gameweekId])
  @@index([gameweekId])
  @@index([playerId])
}



