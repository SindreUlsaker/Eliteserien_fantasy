// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  /// ID fra fantasy-spillet (teams.id)
  id Int @id

  name      String
  shortName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players   Player[]
}

model Player {
  /// ID fra fantasy-spillet (elements.id)
  id Int @id

  firstName  String
  secondName String
  webName    String

  teamId     Int
  team       Team @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  positionId Int
  status     String
  removed    Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  effectiveOwnership EffectiveOwnership[]
  entryPicks EntryPick[]
  gameweekStats PlayerGameweekStats[]

  @@index([teamId])
  @@index([positionId])
}

model Gameweek {
  /// ID fra fantasy-spillet (events.id)
  id Int @id

  name String

  deadlineTime DateTime
  releaseTime  DateTime?

  finished    Boolean @default(false)
  dataChecked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  effectiveOwnership EffectiveOwnership[]
  entries EntryGameweek[]
  playerStats PlayerGameweekStats[]
  chipUsages ChipUsage[]
  bracketStats BracketStats[] @relation("BracketStatsComputedThrough")

  @@index([deadlineTime])
  @@index([finished])
}

model Bracket {
  id        Int      @id @default(autoincrement())

  /// F.eks. "1-100", "101-500", ...
  name      String

  /// Inkluderende rank-grenser (disjunkte intervaller)
  rankFrom  Int
  rankTo    Int

  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stats BracketStats?

  @@unique([rankFrom, rankTo])
  @@index([active])
}

model BracketStats {
  id        Int      @id @default(autoincrement())

  bracketId Int  @unique
  bracket   Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// “Hvor langt” baseline gjelder (typisk siste finished GW)
  computedThroughGameweekId Int
  computedThroughGameweek   Gameweek @relation("BracketStatsComputedThrough", fields: [computedThroughGameweekId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Bump når dere endrer beregningslogikk/format på data
  version   Int      @default(1)

  /// Hvor mange entries som inngikk i baseline (for debug/coverage)
  sampleSize Int?

  /// Ferdig baseline-data til UI (captain/pos/xi/hits/chips/risk osv)
  data      Json

  computedAt DateTime @default(now())

  @@index([computedThroughGameweekId])
  @@index([version])
}

model EffectiveOwnership {
  id           Int      @id @default(autoincrement())

  gameweekId   Int
  playerId     Int

  /// 0.0–1.0 (fraction)
  eo           Float

  /// Hvor mange entries som inngikk i template-samplet (typisk 1000)
  sampleSize   Int

  ownedCount   Int?
  captainCount Int?

  computedAt   DateTime @default(now())

  gameweek     Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([gameweekId, playerId])
  @@index([gameweekId])
  @@index([playerId])
}

model Entry {
  /// ID fra fantasy-spillet (entry id)
  id Int @id

  /// Lagnavn
  entryName String

  /// Fullt navn / manager name
  playerName String

  /// Siste kjente rank i overall (fra standings)
  lastOverallRank  Int?
  lastOverallTotal Int?

  /// Hvilken league vi sist syncet fra (typisk 329)
  sourceLeagueId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameweeks EntryGameweek[]
  chipUsages ChipUsage[]
  insights  EntryInsights?
  seasonTotals EntrySeasonTotals?

  @@index([entryName])
  @@index([playerName])
  @@index([lastOverallRank])
}

model EntryGameweek {
  id         Int      @id @default(autoincrement())

  entryId    Int
  gameweekId Int

  fetchedAt  DateTime @default(now())

  points             Int?
  totalPoints        Int?
  overallRank        Int?
  rank               Int?
  bank               Int?
  value              Int?
  eventTransfers     Int?
  eventTransfersCost Int?

  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gameweek  Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  picks     EntryPick[]

  @@unique([entryId, gameweekId])
  @@index([gameweekId])
  @@index([entryId])
}

model EntryPick {
  id              Int  @id @default(autoincrement())

  entryGameweekId Int

  /// Player id fra fantasy (elements.id)
  playerId        Int
  position        Int
  multiplier      Int
  isCaptain       Boolean
  isViceCaptain   Boolean
  elementType     Int

  entryGameweek   EntryGameweek @relation(fields: [entryGameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([entryGameweekId, position])
  @@index([playerId])
}

model EntryInsights {
  id        Int      @id @default(autoincrement())

  entryId   Int      @unique

  computedThroughGameweekId Int
  version   Int      @default(1)
  data      Json
  computedAt DateTime @default(now())

  entry     Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([computedThroughGameweekId])
}

model PlayerGameweekStats {
  id         Int      @id @default(autoincrement())

  playerId   Int
  gameweekId Int

  fixtureCount Int @default(0)

  totalPoints Int @default(0)
  minutes     Int @default(0)

  goalsScored Int @default(0)
  assists     Int @default(0)
  cleanSheets Int @default(0)
  goalsConceded Int @default(0)

  yellowCards Int @default(0)
  redCards    Int @default(0)

  saves       Int @default(0)
  bonus       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([playerId, gameweekId])
  @@index([gameweekId])
  @@index([playerId])
}

model ChipUsage {
  id         Int      @id @default(autoincrement())

  entryId    Int
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  gameweekId Int
  gameweek   Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  chipName   String
  points     Int?
  usedAt     DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entryId, gameweekId, chipName])
  @@index([gameweekId])
  @@index([entryId])
  @@index([chipName])
}

model EntrySeasonTotals {
  id        Int @id @default(autoincrement())

  entryId   Int @unique
  entry     Entry @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  lastUpdatedGw Int @default(0)
  gwCount       Int @default(0)

  captainPointsTotal Int @default(0)

  xiGkpPointsTotal Int @default(0)
  xiDefPointsTotal Int @default(0)
  xiMidPointsTotal Int @default(0)
  xiFwdPointsTotal Int @default(0)

  transferCostTotal Int @default(0)
  hitCount          Int @default(0)

  captainSuccess5PlusCount Int  @default(0)
  captainTop3Json          Json @default("[]")

  xiGkpCountTotal Int @default(0)
  xiDefCountTotal Int @default(0)
  xiMidCountTotal Int @default(0)
  xiFwdCountTotal Int @default(0)

  // --- NEW: season-to-date EO playstyle ---
  teamEOTotal   Float @default(0)  // sum av teamEO per GW
  teamEOCount   Int   @default(0)  // antall GWs med full EO-coverage (se logikk)
  captainEOTotal Float @default(0) // sum av captain EO per GW (EO * 2)
  captainEOCount Int   @default(0) // antall GWs der captain EO finnes
  captainShareTotal Float @default(0) // sum av captainShare per GW (captainCount/sampleSize)
  captainShareCount Int   @default(0)  // antall GWs der captainShare finnes

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([lastUpdatedGw])
}

