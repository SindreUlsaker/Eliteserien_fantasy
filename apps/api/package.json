{
  "name": "@eliteserien/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=../../prisma/schema.prisma",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema=../../prisma/schema.prisma",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema=../../prisma/schema.prisma",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema=../../prisma/schema.prisma",
    "data:sync-players": "dotenv -e ../../.env -- tsx src/scripts/syncPlayers.ts",
    "data:sync-teams": "dotenv -e ../../.env -- tsx src/scripts/syncTeams.ts",
    "data:sync-gameweeks": "dotenv -e ../../.env -- tsx src/scripts/syncGameweeks.ts",
    "db:seed:brackets": "dotenv -e ../../.env -- tsx src/scripts/seedBrackets.ts",
    "sync:entries": "dotenv -e ../../.env -- tsx src/scripts/syncEntries.ts",
    "data:sync-entry-picks": "dotenv -e ../../.env -- tsx src/scripts/syncEntryPicks.ts",
    "data:sync-entry-insights": "dotenv -e ../../.env -- tsx src/scripts/syncEntryInsights.ts",
    "data:sync-player-gw-stats": "dotenv -e ../../.env -- tsx src/scripts/syncPlayerGameweekStats.ts",
    "compute:template-eo": "dotenv -e ../../.env -- tsx src/scripts/computeTemplateEO.ts",
    "compute:bracket-stats-snapshot": "dotenv -e ../../.env -- tsx src/scripts/computeBracketStatsSnapshot.ts",
    "compute:entry-season-totals": "dotenv -e ../../.env -- tsx src/scripts/computeEntrySeasonTotals.ts",
    "jobs:plan": "dotenv -e ../../.env -- tsx src/scripts/planScheduledJobs.ts",
    "jobs:execute": "dotenv -e ../../.env -- tsx src/scripts/executeScheduledJobs.ts",
    "db:purge-all-data": "dotenv -e ../../.env -- tsx src/scripts/purgeAllData.ts",
    "db:reinitialize-season-data": "dotenv -e ../../.env -- tsx src/scripts/reinitializeSeasonData.ts",
    "db:clear:entry-season-totals": "dotenv -e ../../.env -- tsx src/scripts/clearEntrySeasonTotals.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "8",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.25.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.56.0",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
